# Kopieren nach .env und die Passwörter ändern. Die Datei .env nicht ins Git-Repository einchecken.

# TimescaleDB (im PLC Logger: Datenbankname / Benutzer / Passwort)
TS_DB=datenlogger
TS_USER=logger
TS_PASSWORD=bitte-aendern

# QuestDB, PostgreSQL-Schnittstelle (nur Grafana; der PLC Logger schreibt über HTTP ohne Anmeldung)
QDB_PG_USER=admin
QDB_PG_PASSWORD=bitte-aendern

# InfluxDB 3 Core (im PLC Logger: Datenbankname; Token nur, wenn die Anmeldung eingeschaltet ist)
INFLUX_DB=datenlogger
INFLUX_TOKEN=

# VictoriaMetrics: Aufbewahrungsdauer der Daten (z. B. 3M, 1y, 5y)
VM_RETENTION=1y

# Grafana-Anmeldung (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=bitte-aendern
