// =====================================================================================================================
//  PLC Datenlogger – Ringpuffer für zyklussynchrone Aufzeichnung
//  S7-1200 / S7-1500, SCL-Quelle für TIA Portal (Projektnavigation › Externe Quellen › Neue externe Datei hinzufügen,
//  dann „Bausteine aus Quelle generieren“)
//
//  Die Steuerung schreibt bei jedem Aufruf einen Datensatz (Nummer, Zeit, Werte) in einen Ringpuffer. Der Logger holt
//  die Datensätze ab und zeichnet sie lückenlos mit der Zeit aus der Steuerung auf.
//
//  Wichtig: Der Datenbaustein "PLC_Ringpuffer" ist NICHT optimiert (S7_Optimized_Access := 'FALSE'), damit der Logger
//  ihn byteweise lesen kann. Seine Nummer vergibt TIA Portal beim Generieren (Eigenschaften des DB, z. B. auf 100
//  stellen) – sie gehört in die Adresse im Logger.
//
//  Einstellungen im Logger (Konfigurationsprogramm › Blöcke):
//      Treiber "tia" (S7CommPlus, ohne PUT/GET) oder "s7" (PUT/GET in der CPU erlauben)
//      Startadresse  DB100.DBX0.0     Format REAL     Anzahl 10     Ringpuffer 100
//  Leseintervall der Steuerung z. B. 250 ms. Puffergröße: mindestens 3 × Leseintervall ÷ Zykluszeit
//  (Beispiel: 10-ms-Weckalarm, 250 ms Leseintervall -> mindestens 75 Datensätze; 100 gewählt).
//
//  Anpassen: Anzahl Werte (hier 10: Array[0..9]) im Typ "PLC_Datensatz" UND im Eingang des FC, Anzahl Datensätze (hier
//  100: Array[0..99]) im DB UND in der Konstanten N_DATENSAETZE.
//  Aufruf: z. B. im Weckalarm-OB "Cyclic interrupt" (OB30, Zyklus 10 ms oder 50 ms) oder im Main (OB1):
//      "PLC_Puffer_Schreiben"(Werte := "Messwerte".Werte);
//  Zeit: Systemzeit der CPU (RD_SYS_T) als ms seit Mitternacht – der Logger rechnet den Tageswechsel heraus.
// =====================================================================================================================

TYPE "PLC_Datensatz"
VERSION : 0.1
   STRUCT
      Seq : DInt;                            // Nummer des Datensatzes (= Zaehler beim Schreiben)
      Zeit : DInt;                           // Zeit in ms seit Mitternacht
      Werte : Array[0..9] of Real;           // aufgezeichnete Werte ("Anzahl" im Logger)
   END_STRUCT;
END_TYPE

DATA_BLOCK "PLC_Ringpuffer"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT
      Zaehler : DInt;                        // Anzahl geschriebener Datensätze – Adresse im Logger: DBnnn.DBX0.0
      Daten : Array[0..99] of "PLC_Datensatz";   // Datensätze ("Ringpuffer" im Logger)
   END_STRUCT;
BEGIN
END_DATA_BLOCK

FUNCTION "PLC_Puffer_Schreiben" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Werte : Array[0..9] of Real;           // aufzuzeichnende Werte
   END_VAR
   VAR_TEMP
      n : DInt;
      slot : DInt;
      ret : Int;
      jetzt : DTL;
   END_VAR
   VAR CONSTANT
      N_DATENSAETZE : DInt := 100;           // = Anzahl Elemente von "PLC_Ringpuffer".Daten
   END_VAR

BEGIN
	// Reihenfolge nicht ändern: erst Werte und Zeit, dann Seq, zuletzt der Zähler.
	#n := "PLC_Ringpuffer".Zaehler + 1;
	IF #n >= 2000000000 THEN               // nach Jahren: von vorn zählen (der Logger erkennt das)
	    #n := 1;
	END_IF;
	#slot := #n MOD #N_DATENSAETZE;
	#ret := RD_SYS_T(#jetzt);
	"PLC_Ringpuffer".Daten[#slot].Werte := #Werte;
	"PLC_Ringpuffer".Daten[#slot].Zeit := ((USINT_TO_DINT(#jetzt.HOUR) * 60 + USINT_TO_DINT(#jetzt.MINUTE)) * 60
	    + USINT_TO_DINT(#jetzt.SECOND)) * 1000 + UDINT_TO_DINT(#jetzt.NANOSECOND / 1000000);
	"PLC_Ringpuffer".Daten[#slot].Seq := #n;
	"PLC_Ringpuffer".Zaehler := #n;
END_FUNCTION
